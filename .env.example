# Copy this file to .env and fill it in. Never commit .env.

MONGODB_URI=
DB_NAME=wattatlas
PORT=3000

# A long random string. One way to make one:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed for npm run seed:states.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Set to production on the host so session cookies are secure.
NODE_ENV=development
